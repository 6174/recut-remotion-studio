{
  "name": "@recut/remotion-kit",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Shared Remotion components for Recut Remotion Studio: 13 caption themes, 81 vendored remotion-templates, shotcraft components and effects.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./captions": "./src/captions/index.ts",
    "./effects": "./src/effects/index.ts",
    "./shotcraft": "./src/components/shotcraft/index.ts",
    "./templates": "./src/components/remotion-templates/index.ts",
    "./templates/*": "./src/components/remotion-templates/*.tsx",
    "./shotcraft/*": "./src/components/shotcraft/*.tsx"
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "remotion": "^4.0.0",
    "three": "*"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
