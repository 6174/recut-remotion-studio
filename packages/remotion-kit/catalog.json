      "motion": "聚光→推进→悬浮；单一主角完整动作弧"
    },
    "clean-editorial": {
      "label": "简洁杂志排版",
      "description": "几何背景、大字排版；适合新闻、教育、报告类内容",
      "motion": "直线滑动、克制的过冲；信息先于装饰"
    },
    "vibrant-tech": {
      "label": "科技活力风",
      "description": "渐变色块、高能量运动；适合产品发布、演示与社交媒体",
      "motion": "高能量入场、轻微过冲；批量元素靠运动本身表达"
    },
    "motion-explainer": {
      "label": "Remotion 知识讲解",
      "description": "代码窗口转为播放器的深色讲解模板；适合技术原理、产品机制与教程",
      "motion": "提问钩子 → 代码逐行显现 → 播放器完成收束；用代码卡、进度条和光晕组成完整叙事"
    },
    "product-launch": {
      "label": "产品发布片",
      "description": "霓虹渐变、浮层功能卡与大字卖点；适合新功能、SaaS 与品牌发布",
      "motion": "主张先落版，再由三张功能卡依次推进，底部标签收束；高能但每个动作只服务一个卖点"
    },
    "data-briefing": {
      "label": "数据叙事报告",
      "description": "编辑数据页、数字翻牌和增长条；适合复盘、研究结论与业务汇报",
      "motion": "结论标题 → 关键数字翻牌 → 三层数据条推进；克制留白，让数据本身成为动画"
    },
    "creator-collage": {
      "label": "创作者拼贴板",
      "description": "纸张纹理、便利贴与杂志式中文字排版；适合观点视频、创作过程与文化内容",
      "motion": "标题先定调，四张拼贴卡错峰贴入，最后以一句旁白收束；像一面正在完成的灵感墙"
    },
    "biennale-yellow": {
      "label": "太阳黄双年展",
      "description": "暖羊皮纸、太阳黄光晕、衬线大标题和细线规则；适合文化、教育与有温度的讲解",
      "motion": "黄光缓慢呼吸，标题落版，细线与短文完成收束；留白优先，让一个观点获得充足停留"
    },
    "blockframe": {
      "label": "粗框新粗野主义",
      "description": "粗黑边、硬阴影和糖果撞色的信息卡；适合高能教程、功能清单与年轻品牌",
      "motion": "大字先砸入，三张厚边卡横向撞进；使用硬切和明确位移，不使用含糊的柔和过渡"
    },
    "cobalt-grid": {
      "label": "钴蓝编辑网格",
      "description": "纸张底、钴蓝网格、衬线标题与编号资料条；适合研究、报告和知识分解",
      "motion": "主结论先显现，编号资料条按层级向右生长；网格固定不动，信息运动必须可追踪"
    },
    "bold-poster": {
      "label": "红色大胆海报",
      "description": "奶油纸、倾斜红色版块与极大号标题；适合单一强观点、活动预告和社交封面",
      "motion": "斜切色块先定画面，大标题带旋转缩放打入，最后以三行短句压轴；一屏只讲一个主张"
    },
    "capsule-editorial": {
      "label": "糖果胶囊编辑风",
      "description": "圆角胶囊、珊瑚底和糖果色步骤标签；适合流程、方法论和轻量产品介绍",
      "motion": "主题先落在大胶囊上，步骤胶囊错峰弹起并排成路径；圆润但节奏清楚，避免元素同时出现"
    },
    "editorial-forest": {
      "label": "森林编辑风",
      "description": "森林绿、粉色强调与米纸三色编辑系统；适合深度观点、品牌故事与创作随笔",
      "motion": "标题由上向下生长，三个主题标签分层出现，暗绿圆形形成结尾空间；让层级像树冠一样展开"
    }
