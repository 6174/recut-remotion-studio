    "paper-collage": {
      "label": "纸拼贴编辑风",
      "description": "纸质拼贴、编辑杂志感；适合解说、知识与观点内容",
      "motion": "低能量、缓慢推进、落定后呼吸；像一篇会动的杂志文章"
    },
    "cinematic-dark": {
      "label": "电影感深色",
